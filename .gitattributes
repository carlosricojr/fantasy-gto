# Test fixtures are byte-exact slices of upstream nflverse data. Git must not
# rewrite their line endings: the CSV parser's behaviour around line terminators
# is under test, so a platform-dependent checkout would make tests non-reproducible.
tests/fixtures/*.csv -text

# Generated by pnpm-lock; keep diffs readable but never merge them by hand.
pnpm-lock.yaml -diff linguist-generated
