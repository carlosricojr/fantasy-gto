{
  "name": "fantasy-gto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev --turbo",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm typecheck:convex && pnpm lint && pnpm test:run",
    "backtest": "tsx scripts/backtest.ts",
    "coverage-audit": "tsx scripts/coverage-audit.ts",
    "verify-sources": "tsx scripts/verify-sources.ts",
    "draft-backtest": "tsx scripts/draft-backtest.ts",
    "draft-mock": "tsx scripts/draft-mock.ts",
    "draft-strategy-eval": "tsx scripts/draft-strategy-eval.ts",
    "identity-coverage": "tsx scripts/identity-coverage.ts",
    "mutate": "tsx scripts/mutate.ts",
    "draft-latency": "tsx scripts/draft-latency.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.6",
    "@clerk/nextjs": "^6.39.6",
    "@clerk/themes": "^2.4.13",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@serwist/next": "^9.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^0.541.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "~19.1.4",
    "react-dom": "~19.1.4",
    "react-hook-form": "^7.62.0",
    "serwist": "^9.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.54",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "happy-dom": "^21.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "brace-expansion@2": "2.1.7",
      "minimatch@9": "11.0.7",
      "glob": "14.0.2",
      "postcss": "^8.5.25",
      "sharp": "^0.35.5",
      "@humanfs/node": "0.16.8",
      "ajv@6": "6.14.0",
      "brace-expansion@1": "1.1.21",
      "flatted": "3.4.2",
      "js-yaml@4": "4.3.2",
      "minimatch@3": "3.1.4",
      "nanoid@3": "3.3.18",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "tar@7": "7.5.21",
      "vite@8": "8.2.4",
      "zod@4": "4.6.7"
    }
  }
}
