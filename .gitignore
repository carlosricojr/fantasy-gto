# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated service worker (built from app/sw.ts by @serwist/next)
/public/sw.js
/public/sw.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignored for the template, you probably want to remove it:
package-lock.json

# clerk configuration (can include secrets)
/.clerk/

# local data cache for the backtest
/.cache/

# agent/tooling scratch files — must never be committed
scripts/__tmp_*
**/__proto/

# Left only if a mutation run is killed mid-test; the next run cleans it up.
*.mutate-backup
.mutate-lock

# Agent worktrees — ephemeral checkouts, never part of the tree
.claude/worktrees/
