# Copy to .env.local. Two separate stores are in play, and putting a value in the wrong
# one fails quietly:
#
#   .env.local            read by Next.js (browser + server)
#   Convex deployment     read by convex/, set with `npx convex env set NAME value`
#
# Convex functions cannot see .env.local. CLERK_WEBHOOK_SECRET in particular must be set
# on the deployment, because the webhook handler runs there — see below.

# --- .env.local -------------------------------------------------------------------

# From `npx convex dev`, which writes both automatically.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# The .site origin of the same deployment. This is where Convex serves convex/http.ts,
# and it is the host the Clerk webhook must point at. Same subdomain, different suffix.
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Clerk → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk → your instance's Frontend API URL, e.g. https://example-42.clerk.accounts.dev
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# --- Convex deployment ------------------------------------------------------------
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev
# npx convex env set CLERK_WEBHOOK_SECRET whsec_...
#
# CLERK_JWT_ISSUER_DOMAIN  — same value as NEXT_PUBLIC_CLERK_FRONTEND_API_URL. Convex
#                            verifies Clerk's JWTs against it; without it every
#                            authenticated query resolves as anonymous.
# CLERK_WEBHOOK_SECRET     — the signing secret of the endpoint below. Without it the
#                            handler rejects every delivery and no subscription is
#                            ever recorded.
