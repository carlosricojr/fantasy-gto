{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    /* No `paths` mapping here on purpose. Everything under `lib/` imports by relative
     * path, so the domain core resolves identically under tsc, vitest, tsx, and the
     * esbuild bundler Convex uses. Convex's bundler does honor tsconfig paths, but
     * depending on that would make the deploy fragile: four different resolvers would
     * each need the alias configured, and the failure only appears at bundle time. */

    /* These compiler options are required by Convex */
    "target": "ESNext",
    /* ES2022 rather than the generated default of ES2021. Files under `lib/` are compiled
     * by both projects, and the root one allows `esnext`, so anything newer than ES2021
     * typechecks in CI and then fails here — where it matters, because this is the check
     * `convex dev` and `convex deploy` run. `Object.hasOwn` did exactly that and blocked
     * every deploy for three days while `pnpm verify` stayed green. Convex runs a current
     * V8 isolate, so ES2022 is available at runtime; the old value was understating it. */
    "lib": ["ES2022", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
